# 冗余压缩包(源文件已在仓库内)
.agents/skills/*.zip

# 不可访问文件(文件系统不支持 ACL,文件名编码异常)
skills-improved/*.md

# Trae文件
.uploads
.playwright-browsers
.trae/

# 依赖
node_modules/

# 构建产物(各 workspace 自行决定是否保留 dist)
packages/*/dist/

# 测试文件夹
test-results
apple-decision-video

# 历史归档快照(已合并进主目录,仅本地保留)
engine_ref/

# 系统文件
.DS_Store
Thumbs.db
debug.log

# 一次性调试产物(脚本本身保留,运行产物不入库)
scripts/debug/
product-tour/scripts/debug/

# product-tour 缓存与渲染产物(不入库)
product-tour/.hyperframes/
product-tour/.thumbnails/
product-tour/renders/

# 敏感密钥(小程序主体私钥等,严禁入库)
*.key
private.*

# 云端发布凭证(AppSecret, 严禁入库)
scripts/.wx-publish-credentials.json
