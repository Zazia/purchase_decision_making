    "components.css",
    "preview/component-button.html",
    "preview/component-card.html",
    "preview/component-table.html",
    "preview/component-chart.html",
    "preview/component-navigation.html",
    "preview/component-badge.html",
    "ui_kits/dashboard/index.html"
  ]
}
