/* pages/result/result.wxss */
/* 设计 token 对齐 constants.json design_tokens */

.container {
  min-height: 100vh;
  background: #F5F5F7;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

/* ============ 状态容器 ============ */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.state-text {
  font-size: 30rpx;
  color: #86868F;
  margin-top: 32rpx;
}

.error-text {
  color: #F24B4B;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #D2D2D8;
  border-top-color: #007AFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.retry-btn {
  margin-top: 32rpx;
  padding: 20rpx 64rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 30rpx;
  border-radius: 999rpx;
}

.retry-btn:active {
  background: #0063D4;
}

/* ============ 空结果卡片 ============ */
.empty-card {
  background: #FFF0C2;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #E09500;
  margin-bottom: 8rpx;
}

.empty-suggestion {
  font-size: 26rpx;
  color: #86868F;
}

/* ============ 结论卡片 ============ */
.conclusion-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(29, 29, 31, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 24rpx;
}

/* ============ 方案列表 ============ */
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  background: #F5F5F7;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.plan-card:active {
  background: #E6F2FF;
  border-color: #007AFF;
  transform: scale(0.98);
}

.plan-card.in-range {
  background: #E6F2FF;
  border-color: #007AFF;
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.plan-model {
  font-size: 30rpx;
  font-weight: 500;
  color: #1D1D1F;
  flex: 1;
  margin-right: 16rpx;
}

.plan-badges {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.badge-new {
  background: #D9F0E3;
  color: #2A8A61;
}

.badge-used {
  background: #FFD9D9;
  color: #9F1239;
}

.badge-hold {
  background: #F5F5F7;
  color: #86868F;
}

/* 候选类型徽章: 等新品后/等新品降价 (橙色) */
.badge-wait {
  background: #FFE9D1;
  color: #C25E00;
}

/* 预测价小标 */
.predict-tag {
  display: inline-block;
  margin-left: 6rpx;
  padding: 0 8rpx;
  font-size: 18rpx;
  color: #C25E00;
  background: #FFE9D1;
  border-radius: 6rpx;
  vertical-align: middle;
}

/* ============ 方案指标 ============ */
.plan-metrics {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
}

.metric {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.metric:first-child {
  flex-direction: row;
  align-items: baseline;
  gap: 4rpx;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #007AFF;
  font-family: 'DM Sans', -apple-system, sans-serif;
}

.metric-unit {
  font-size: 24rpx;
  color: #86868F;
}

.metric-label {
  font-size: 22rpx;
  color: #86868F;
}

.metric-value-sm {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D1D1F;
}

/* ============ 图表卡片 ============ */
.chart-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(29, 29, 31, 0.06);
}

.chart-desc {
  font-size: 24rpx;
  color: #86868F;
  margin-bottom: 20rpx;
}

.chart-legend {
  display: flex;
  gap: 32rpx;
  margin-bottom: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #86868F;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-frontier {
  background: #007AFF;
}

/* 等新品方案 (类型 B/C) 浅蓝半透明 */
.legend-wait {
  background: #5AC8FA;
  opacity: 0.7;
}

.legend-dominated {
  background: #C7C7CC;
  opacity: 0.5;
}

.legend-line {
  width: 24rpx;
  height: 4rpx;
}

.legend-floor {
  background: #2A8A61;
}

.legend-budget {
  background: #FF9500;
}

/* ============ 页脚 ============ */
.footer {
  text-align: center;
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
}

/* ============ 分享按钮 ============ */
.share-btn-wrap {
  padding: 16rpx 0 8rpx;
}

.share-btn {
  background: #1D1D1F;
  color: #FFFFFF;
  text-align: center;
  padding: 28rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.share-btn:active {
  opacity: 0.85;
}

/* ============ 报告入口 ============ */
.report-entry-wrap {
  padding: 8rpx 0 16rpx;
  text-align: center;
}

.report-entry {
  display: inline-block;
  padding: 20rpx 48rpx;
  color: #007AFF;
  font-size: 30rpx;
  font-weight: 500;
  border: 2rpx solid #007AFF;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.report-entry:active {
  background: #E6F2FF;
}

.footer-fresh {
  background: transparent;
}

.footer-stale {
  background: #FFF0C2;
}

.footer-expired {
  background: #FFD9D9;
}

.footer-text {
  display: block;
  font-size: 24rpx;
  color: #86868F;
  margin-bottom: 8rpx;
}

.footer-hint {
  display: block;
  font-size: 24rpx;
  color: #E09500;
}

.footer-expired .footer-hint {
  color: #F24B4B;
}

.footer-link {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  background: #1D1D1F;
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.footer-link:active {
  opacity: 0.8;
}
