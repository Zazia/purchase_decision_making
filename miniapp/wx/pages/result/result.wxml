<!-- pages/result/result.wxml -->
<view class="container">
  <!-- Loading -->
  <view class="state-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="state-text">{{loadingHint}}</text>
  </view>

  <!-- Error -->
  <view class="state-wrap" wx:elif="{{error}}">
    <text class="state-text error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">重试</view>
  </view>

  <!-- Result -->
  <block wx:else>
    <!-- 编辑模式 (manual-scheme-editor) -->
    <block wx:if="{{editorMode === 'edit'}}">
      <view class="editor-header">
        <view class="editor-back-btn" bindtap="onExitEditor">‹</view>
        <view class="editor-header-actions">
          <view class="editor-recompute-btn" bindtap="onEditorRecompute">重算报告</view>
          <view class="editor-export-btn" bindtap="onEditorExport">导出长图</view>
        </view>
        <view class="editor-undo-btn {{!canUndo ? 'disabled' : ''}}" bindtap="onEditorUndo">
          <image src="/assets/icons/undo.svg" mode="aspectFit" class="undo-icon" />
        </view>
      </view>

      <view class="editor-content">
        <view class="editor-intro">按您自己的调研结果修改方案</view>

        <!-- 条件筛选面板 (折叠) -->
        <view class="filter-panel">
          <view class="filter-toggle" bindtap="onToggleFilterPanel">
            <text>条件筛选</text>
            <text class="filter-arrow">{{filterExpanded ? '▲' : '▼'}}</text>
          </view>
          <view class="filter-body" wx:if="{{filterExpanded}}">
            <!-- 前沿状态 -->
            <view class="filter-group">
              <view class="filter-group-label">前沿状态</view>
              <view class="filter-chips">
                <view class="filter-chip {{item.active ? 'active' : ''}}" wx:for="{{filterFrontierState}}" wx:key="value" data-dim="frontierState" data-value="{{item.value}}" bindtap="onFilterToggle">{{item.label}}</view>
              </view>
            </view>
            <!-- 芯片/型号 -->
            <view class="filter-group">
              <view class="filter-group-label">{{params.category === 'iphone' ? '型号' : '芯片'}}</view>
              <view class="filter-chips">
                <view class="filter-chip {{item.active ? 'active' : ''}}" wx:for="{{filterChips}}" wx:key="value" data-dim="chip" data-value="{{item.value}}" bindtap="onFilterToggle">{{item.label}}</view>
              </view>
            </view>
            <!-- 内存 -->
            <view class="filter-group">
              <view class="filter-group-label">内存</view>
              <view class="filter-chips">
                <view class="filter-chip {{item.active ? 'active' : ''}}" wx:for="{{filterMemory}}" wx:key="value" data-dim="memory" data-value="{{item.value}}" bindtap="onFilterToggle">{{item.label}}</view>
              </view>
            </view>
            <!-- 存储 -->
            <view class="filter-group">
              <view class="filter-group-label">存储</view>
              <view class="filter-chips">
                <view class="filter-chip {{item.active ? 'active' : ''}}" wx:for="{{filterStorage}}" wx:key="value" data-dim="storage" data-value="{{item.value}}" bindtap="onFilterToggle">{{item.label}}</view>
              </view>
            </view>
            <!-- 持有期 (三态: all/partial/none) -->
            <view class="filter-group">
              <view class="filter-group-label">持有期</view>
              <view class="filter-chips">
                <view class="filter-chip {{item.state === 'all' ? 'active' : ''}} {{item.state === 'partial' ? 'partial' : ''}}" wx:for="{{filterHolding}}" wx:key="value" data-dim="holding" data-value="{{item.value}}" bindtap="onFilterToggle">{{item.label}}</view>
              </view>
            </view>
            <!-- 新品/二手 -->
            <view class="filter-group">
              <view class="filter-group-label">买入时机</view>
              <view class="filter-chips">
                <view class="filter-chip {{item.active ? 'active' : ''}}" wx:for="{{filterTiming}}" wx:key="value" data-dim="timing" data-value="{{item.value}}" bindtap="onFilterToggle">{{item.label}}</view>
              </view>
            </view>
          </view>
        </view>

        <!-- 主列表方案表格 (按前沿状态分组 → model+buyTiming 分组, 持有期多选) -->
        <view class="editor-table">
          <block wx:for="{{editorDisplayGroups}}" wx:for-item="section" wx:key="frontierState">
          <view class="frontier-section-header">
            <view class="frontier-section-title">
              <text class="frontier-section-label {{section.frontierState === '前沿方案' ? 'label-frontier' : section.frontierState === '靠近前沿方案' ? 'label-near' : 'label-other'}}">{{section.frontierState}}</text>
              <text class="frontier-section-count">{{section.groups.length}}</text>
            </view>
          </view>
          <view class="editor-row {{item.excluded ? 'excluded' : ''}} {{item.groupKey === animateGroupKey ? 'animate-highlight' : ''}}" id="{{item.groupAnchorId}}" wx:for="{{section.groups}}" wx:key="groupKey">
            <view class="editor-row-header">
              <view class="editor-row-info">
                <text class="editor-model">{{item.modelBase}}</text>
                <text class="editor-tag tag-custom" wx:if="{{item.source === 'custom'}}">自添加</text>
                <text class="editor-tag tag-edited" wx:if="{{item.source === 'edited'}}">已改价</text>
                <text class="editor-tag tag-excluded" wx:if="{{item.excluded}}">已排除</text>
              </view>
              <view class="editor-row-meta">
                <view class="holding-multiselect-btn" data-group-key="{{item.groupKey}}" bindtap="onToggleHoldingMenu">
                  持有期 {{item.activeCount}}/{{item.totalCount}} ▾
                </view>
              </view>
            </view>

            <!-- 持有期多选弹出菜单 -->
            <view class="holding-menu" wx:if="{{openHoldingMenuKey === item.groupKey}}">
              <view class="holding-menu-item" wx:for="{{item.holdingVariants}}" wx:for-item="variant" wx:key="rowId"
                    data-row-id="{{variant.rowId}}" bindtap="onToggleHoldingVariant">
                <view class="checkbox-icon {{variant.active ? 'checked' : ''}}"></view>
                <text>{{variant.years}}年</text>
                <text class="variant-cost">¥{{variant.monthlyCost}}/月</text>
              </view>
            </view>

            <view class="editor-row-fields">
              <!-- 买入价 -->
              <view class="field-group price-group {{item.channel === undefined ? 'readonly' : ''}}">
                <text class="price-prefix">￥</text>
                <input
                  class="price-input {{editorPriceErrors[item.groupKey] ? 'error' : ''}}"
                  type="digit"
                  value="{{item.editedBuyPrice || item.buyPrice}}"
                  data-group-key="{{item.groupKey}}"
                  disabled="{{item.channel === undefined}}"
                  bindinput="onEditorPriceChange"
                  bindblur="onEditorPriceBlur"
                />
                <text class="field-error" wx:if="{{editorPriceErrors[item.groupKey]}}">{{editorPriceErrors[item.groupKey]}}</text>
              </view>

              <!-- 渠道 picker + 自定义输入(横向排列) -->
              <view class="field-group channel-row">
                <picker
                  mode="selector"
                  range="{{editorChannels}}"
                  data-group-key="{{item.groupKey}}"
                  bindchange="onEditorChannelChange"
                >
                  <view class="picker-text">{{item._isCustomChannel ? '其他' : (item.channel || '快照价')}}</view>
                </picker>
                <input
                  wx:if="{{item._isCustomChannel}}"
                  class="custom-channel-input"
                  placeholder="输入渠道"
                  value="{{item.channel}}"
                  data-group-key="{{item.groupKey}}"
                  bindinput="onEditorCustomChannelInput"
                />
              </view>

              <!-- 国补勾选 (所有新品方案均可勾选) -->
              <view class="field-group" wx:if="{{item.buyTiming === 'new'}}">
                <view class="subsidy-toggle {{item.useSubsidy ? 'active' : ''}}" data-group-key="{{item.groupKey}}" bindtap="onEditorSubsidyToggle">
                  <text>{{item.useSubsidy ? '✓ 国补' : '国补'}}</text>
                </view>
              </view>
            </view>

            <view class="editor-row-actions">
              <label class="exclude-checkbox" data-group-key="{{item.groupKey}}" bindtap="onEditorExcludeToggle">
                <view class="checkbox-icon {{item.excluded ? 'checked' : ''}}"></view>
                <text>排除</text>
              </label>
              <view class="action-btn defer-btn" data-group-key="{{item.groupKey}}" bindtap="onEditorDefer">移到末尾</view>
              <view class="row-icon-actions">
                <image wx:if="{{item.source === 'custom'}}" src="/assets/icons/edit.svg" mode="aspectFit" class="row-icon edit-icon" data-group-key="{{item.groupKey}}" bindtap="onEditorEditCustomPlan" />
                <image src="/assets/icons/copy.svg" mode="aspectFit" class="row-icon copy-icon" data-group-key="{{item.groupKey}}" bindtap="onEditorCopyPlan" />
                <image src="/assets/icons/delete.svg" mode="aspectFit" class="row-icon delete-icon" data-group-key="{{item.groupKey}}" bindtap="onEditorDeletePlan" />
              </view>
            </view>
          </view>
          </block>
        </view>

        <!-- 新增自定义方案入口 -->
        <view class="add-plan-entry" bindtap="onEditorShowAddForm" wx:if="{{!editorShowAddForm}}">+ 新增自定义方案</view>

        <!-- 新增/编辑自定义方案表单 -->
        <view class="add-plan-form" wx:if="{{editorShowAddForm}}">
          <view class="form-title">{{editorAddFormMode === 'edit' ? '编辑自添加方案' : '新增自定义方案'}}</view>
          <view class="form-row">
            <text class="form-label">机型名</text>
            <input class="form-input" type="text" placeholder="如 M2 Mac mini" value="{{editorAddForm.model}}" data-field="model" bindinput="onEditorAddFormField" />
          </view>
          <view class="form-row">
            <text class="form-label">芯片</text>
            <picker mode="selector" range="{{editorKnownChips}}" data-field="chip" bindchange="onEditorAddFormField">
              <view class="picker-text">{{editorAddForm.chip || '请选择芯片'}}</view>
            </picker>
          </view>
          <view class="form-row-group">
            <view class="form-row">
              <text class="form-label">内存(GB)</text>
              <input class="form-input" type="digit" value="{{editorAddForm.memoryGb}}" data-field="memoryGb" bindinput="onEditorAddFormField" />
            </view>
            <view class="form-row">
              <text class="form-label">存储(GB)</text>
              <input class="form-input" type="digit" value="{{editorAddForm.storageGb}}" data-field="storageGb" bindinput="onEditorAddFormField" />
            </view>
          </view>
          <view class="form-row">
            <text class="form-label">买入时机</text>
            <picker mode="selector" range="{{['新品', '二手']}}" data-field="buyTiming" bindchange="onEditorAddFormField">
              <view class="picker-text">{{editorAddForm.buyTiming === 'new' ? '新品' : '二手'}}</view>
            </picker>
          </view>
          <view class="form-row form-row-holding">
            <text class="form-label">持有期(可多选)</text>
            <view class="form-chips">
              <view
                class="form-chip {{item.active ? 'active' : ''}}"
                wx:for="{{editorHoldingChips}}"
                wx:key="years"
                data-years="{{item.years}}"
                bindtap="onEditorAddFormHoldingToggle"
              >{{item.label}}</view>
            </view>
          </view>
          <view class="form-row">
            <text class="form-label">买入价</text>
            <input class="form-input" type="digit" placeholder=">0" value="{{editorAddFormMode === 'edit' ? editorAddForm.buyPrice : ''}}" data-field="buyPrice" bindinput="onEditorAddFormField" />
          </view>
          <view class="form-actions">
            <view class="form-btn form-cancel" bindtap="onEditorCancelAddForm">取消</view>
            <view class="form-btn form-confirm" bindtap="onEditorAddPlan">{{editorAddFormMode === 'edit' ? '保存' : '添加'}}</view>
          </view>
        </view>

        <!-- 移到末尾分组 -->
        <view class="deferred-group" wx:if="{{editorDeferredGroups.length > 0}}">
          <view class="deferred-title">移到末尾 ({{editorDeferredGroups.length}})</view>
          <view class="deferred-row" wx:for="{{editorDeferredGroups}}" wx:key="groupKey">
            <text class="deferred-model">{{item.modelBase}}</text>
            <view class="action-btn restore-btn" data-group-key="{{item.groupKey}}" bindtap="onEditorRestore">恢复</view>
          </view>
        </view>
      </view>

      <!-- 自动保存弱提示 (task 3.5) -->
      <view class="auto-save-tip {{autoSaveTipVisible ? 'visible' : ''}}">
        <text>已自动保存</text>
      </view>
    </block>

    <!-- 查看模式 -->
    <block wx:else>
      <!-- viewMode 切换 tabs (仅当有用户修改版时显示) -->
      <view class="view-mode-tabs" wx:if="{{userModified}}">
        <view class="view-mode-tab {{viewMode === 'original' ? 'active' : ''}}" data-mode="original" bindtap="onSwitchViewMode">原始版</view>
        <view class="view-mode-tab {{viewMode === 'userModified' ? 'active' : ''}}" data-mode="userModified" bindtap="onSwitchViewMode">用户修改版</view>
      </view>

      <!-- "基于用户输入价" 标注 (仅 viewMode='userModified') -->
      <view class="user-modified-banner" wx:if="{{viewMode === 'userModified'}}">
        <text>基于用户输入价</text>
      </view>

      <!-- Empty with fallback -->
      <view class="empty-card" wx:if="{{isEmpty}}">
      <view class="empty-icon">⚠️</view>
      <view class="empty-title">当前约束下无非劣方案</view>
      <view class="empty-desc">{{relaxedHint}}</view>
      <view class="empty-suggestion">以下为放宽约束后的最近可行方案</view>
    </view>

    <!-- Conclusion section -->
    <view class="conclusion-card" wx:if="{{!isEmpty && plans.length > 0}}">
      <view class="section-title">推荐方案（按月均成本升序）</view>
      <view class="plan-list">
        <view
          class="plan-card {{item.inRange ? 'in-range' : ''}}"
          wx:for="{{plans}}"
          wx:key="key"
          data-index="{{index}}"
          bindtap="onPlanTap"
        >
          <view class="plan-header">
            <text class="plan-model">{{item.modelLabel}}</text>
            <view class="plan-badges">
              <text class="badge badge-{{item.buyTiming}}">{{item.buyTimingLabel}}</text>
              <text class="badge badge-hold">{{item.holdingYears}}年</text>
              <text class="badge badge-wait" wx:if="{{item.candidateBadge}}">{{item.candidateBadge}}</text>
            </view>
          </view>
          <view class="plan-metrics">
            <view class="metric">
              <text class="metric-value">{{item.monthlyCost}}</text>
              <text class="metric-unit">元/月</text>
            </view>
            <view class="metric">
              <text class="metric-label">性能满足度</text>
              <text class="metric-value-sm">{{item.avgPerformancePct}}%</text>
            </view>
            <view class="metric">
              <text class="metric-label">买入价</text>
              <text class="metric-value-sm">{{item.buyPrice}}元<text class="predict-tag" wx:if="{{item.predictedPrice}}">预测</text></text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Empty fallback plan list -->
    <view class="conclusion-card" wx:if="{{isEmpty && plans.length > 0}}">
      <view class="section-title">最近可行方案</view>
      <view class="plan-list">
        <view
          class="plan-card"
          wx:for="{{plans}}"
          wx:key="key"
          data-index="{{index}}"
          bindtap="onPlanTap"
        >
          <view class="plan-header">
            <text class="plan-model">{{item.modelLabel}}</text>
            <view class="plan-badges">
              <text class="badge badge-{{item.buyTiming}}">{{item.buyTimingLabel}}</text>
              <text class="badge badge-hold">{{item.holdingYears}}年</text>
              <text class="badge badge-wait" wx:if="{{item.candidateBadge}}">{{item.candidateBadge}}</text>
            </view>
          </view>
          <view class="plan-metrics">
            <view class="metric">
              <text class="metric-value">{{item.monthlyCost}}</text>
              <text class="metric-unit">元/月</text>
            </view>
            <view class="metric">
              <text class="metric-label">性能满足度</text>
              <text class="metric-value-sm">{{item.avgPerformancePct}}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Pareto chart -->
    <view class="chart-card" wx:if="{{frontier.length > 0 || dominated.length > 0}}">
      <view class="section-title">帕累托前沿图</view>
      <view class="chart-desc">横轴: 月均成本(越低越省) | 纵轴: 性能满足度(越高越好)</view>
      <view class="chart-legend">
        <view class="legend-item">
          <view class="legend-dot legend-frontier"></view>
          <text>前沿方案</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-wait"></view>
          <text>等新品方案</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-dominated"></view>
          <text>已排除方案</text>
        </view>
        <view class="legend-item" wx:if="{{performanceFloor > 0}}">
          <view class="legend-line legend-floor"></view>
          <text>性能地板</text>
        </view>
        <view class="legend-item" wx:if="{{budget > 0}}">
          <view class="legend-line legend-budget"></view>
          <text>预算线</text>
        </view>
      </view>
      <pareto-chart
        id="chart"
        frontier="{{frontier}}"
        dominated="{{dominated}}"
        recommendation-range="{{recommendationRange}}"
        performance-floor="{{performanceFloor}}"
        budget="{{budget}}"
        bind:pointtap="onChartPointTap"
      />
      <view class="chart-note">前沿上的点不存在性能更高且价格更低的选择</view>
    </view>

    <!-- Generate share card button (原始版且非回看模式) -->
    <view class="share-btn-wrap" wx:if="{{plans.length > 0 && !isReplay && viewMode === 'original'}}">
      <view class="share-btn" bindtap="onGenerateShareCard">保存结果</view>
    </view>

    <!-- 保存用户修改版 → 进入分享卡 (仅 viewMode='userModified') -->
    <view class="share-btn-wrap" wx:if="{{viewMode === 'userModified' && userModified}}">
      <view class="share-btn" bindtap="onSaveUserModified">保存用户修改版</view>
    </view>

    <!-- 查看完整报告入口 -->
    <view class="report-entry-wrap" wx:if="{{plans.length > 0}}">
      <view class="report-entry" bindtap="onOpenReport">查看完整报告 ›</view>
    </view>

    <!-- 手动修改方案入口 (空结果页隐藏) -->
    <view class="report-entry-wrap" wx:if="{{plans.length > 0}}">
      <view class="report-entry" bindtap="onEnterEditor">手动修改方案 ›</view>
    </view>

    <!-- Data freshness footer -->
    <view class="footer footer-{{freshnessLevel}}">
      <text class="footer-text">数据更新于 {{lastUpdated}}</text>
      <text class="footer-hint" wx:if="{{freshnessLevel === 'stale'}}">数据已 {{days}} 天未更新，重启小程序可刷新</text>
      <block wx:if="{{freshnessLevel === 'expired'}}">
        <text class="footer-hint">数据较旧({{days}}天)，建议查看 GitHub 最新版</text>
        <text class="footer-link" bindtap="onOpenGitHub">复制 GitHub 链接</text>
      </block>
    </view>
    </block>
  </block>

  <!-- 项目仓库链接 -->
  <repo-footer />
</view>
