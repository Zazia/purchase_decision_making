/* pages/report/report.wxss */
/* 设计 token 对齐 constants.json design_tokens (与 detail/result 页一致) */
/* 关键数字: font-size 32px(64rpx) font-weight 600 (见 D9 视觉规范) */

.container {
  min-height: 100vh;
  background: #F5F5F7;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

/* ============ 状态容器 ============ */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.state-text {
  font-size: 30rpx;
  color: #86868F;
  margin-top: 32rpx;
}

.error-text {
  color: #F24B4B;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #D2D2D8;
  border-top-color: #007AFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ============ 报告头部 ============ */
.report-header {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(29, 29, 31, 0.06);
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.header-meta {
  font-size: 24rpx;
  color: #86868F;
}

/* ============ 结论卡 (品牌蓝渐变) ============ */
.conclusion-card {
  background: linear-gradient(135deg, #007AFF, #0056CC);
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
}

.conclusion-label {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
}

.conclusion-verdict {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.conclusion-detail {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

/* ============ KPI 行 (4 卡, 2×2 网格) ============ */
.kpi-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.kpi-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  box-shadow: 0 1rpx 4rpx rgba(29, 29, 31, 0.06);
}

.kpi-label {
  font-size: 22rpx;
  color: #86868F;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.kpi-value {
  /* D9 关键数字: font-size 32px ≈ 64rpx, font-weight 600 */
  font-size: 64rpx;
  font-weight: 600;
  color: #007AFF;
  font-family: 'DM Sans', -apple-system, sans-serif;
  line-height: 1.1;
  margin-bottom: 6rpx;
}

.kpi-unit {
  font-size: 22rpx;
  color: #86868F;
}

/* ============ 预警 alert ============ */
.alert {
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.alert-warning {
  background: #FFF4E5;
  border: 2rpx solid #FF9500;
}

.alert-info {
  background: #E8F0FE;
  border: 2rpx solid #007AFF;
}

.alert-error {
  background: #FFD9D9;
  border: 2rpx solid #FF3B30;
}

.alert-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.alert-warning .alert-title { color: #C25E00; }
.alert-info .alert-title { color: #1A56DB; }
.alert-error .alert-title { color: #991B1B; }

.alert-desc {
  font-size: 24rpx;
  color: #1D1D1F;
  line-height: 1.5;
}

/* ============ 区块卡片 ============ */
.section-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(29, 29, 31, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 24rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-row .section-title {
  margin-bottom: 0;
}

.toggle-btn {
  font-size: 26rpx;
  color: #007AFF;
  padding: 8rpx 20rpx;
  border: 2rpx solid #007AFF;
  border-radius: 999rpx;
}

.toggle-btn:active {
  background: #E6F2FF;
}

/* ============ 表格 (移动端横向滚动) ============ */
.table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.table-row {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #E5E7EB;
  min-width: 100%;
}

.table-row:last-child {
  border-bottom: none;
}

.table-head {
  background: #F5F5F7;
  border-radius: 12rpx;
}

.table-head .cell {
  font-size: 22rpx;
  font-weight: 600;
  color: #86868F;
  padding: 16rpx 12rpx;
}

.cell {
  padding: 20rpx 12rpx;
  font-size: 24rpx;
  color: #1D1D1F;
  flex-shrink: 0;
}

/* 推荐方案表列宽 */
.cell-plan { width: 120rpx; }
.cell-config { width: 200rpx; flex: 1; }
.cell-price { width: 140rpx; }
.cell-hold { width: 100rpx; }
.cell-cost { width: 110rpx; font-weight: 600; color: #007AFF; }
.cell-perf { width: 100rpx; }
.cell-reason { width: 280rpx; flex: 2; font-size: 22rpx; color: #86868F; }

/* 全候选表列宽 */
.c-model { width: 200rpx; flex: 1; }
.c-hold { width: 90rpx; }
.c-price { width: 130rpx; }
.c-s0 { width: 70rpx; }
.c-avg { width: 70rpx; }
.c-residual { width: 110rpx; }
.c-cost { width: 100rpx; font-weight: 600; }
.c-pareto { width: 110rpx; }
.c-support { width: 110rpx; }

/* 置信度表列宽 */
.conf-item { width: 220rpx; flex: 1; }
.conf-level { width: 100rpx; }
.conf-desc { width: 320rpx; flex: 2; font-size: 22rpx; color: #86868F; }

.row-highlight {
  background: #E8F0FE;
}

.row-highlight .cell {
  font-weight: 600;
  color: #007AFF;
}

.row-muted .cell {
  color: #86868F;
}

/* ============ 徽章 ============ */
.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-left: 4rpx;
}

.badge-success { background: #D9F0E3; color: #2A8A61; }
.badge-warning { background: #FFE9D1; color: #C25E00; }
.badge-error { background: #FFD9D9; color: #9F1239; }
.badge-wait { background: #FFE9D1; color: #C25E00; }

.predict-tag {
  display: inline-block;
  margin-left: 4rpx;
  padding: 0 6rpx;
  font-size: 18rpx;
  color: #C25E00;
  background: #FFE9D1;
  border-radius: 6rpx;
  vertical-align: middle;
}

/* ============ 展开按钮 ============ */
.expand-btn {
  text-align: center;
  padding: 20rpx;
  margin-top: 16rpx;
  color: #007AFF;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #007AFF;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.expand-btn:active {
  background: #E6F2FF;
}

/* ============ 帕累托图 ============ */
.chart-card {
  /* 留出图表渲染空间 */
}

.chart-desc {
  font-size: 24rpx;
  color: #86868F;
  margin-bottom: 20rpx;
}

.chart-note {
  font-size: 24rpx;
  color: #86868F;
  line-height: 1.5;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #F5F5F7;
  border-radius: 12rpx;
}

/* ============ 宏观因素 ============ */
.macro-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5F5F7;
}

.macro-item:last-child {
  border-bottom: none;
}

.macro-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.macro-dot-warning { background: #FF9500; }
.macro-dot-info { background: #007AFF; }
.macro-dot-error { background: #FF3B30; }

.macro-content {
  flex: 1;
}

.macro-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 6rpx;
}

.macro-desc {
  font-size: 24rpx;
  color: #86868F;
  line-height: 1.5;
}

/* ============ 更新提示 ============ */
.hint-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hint-item {
  font-size: 26rpx;
  color: #86868F;
  line-height: 1.6;
}

/* ============ 导出与转发按钮 ============ */
.export-wrap {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.export-btn, .share-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.export-btn {
  background: #007AFF;
  color: #FFFFFF;
}

.export-btn:active {
  background: #0063D4;
}

.share-btn {
  background: #1D1D1F;
  color: #FFFFFF;
}

.share-btn:active {
  opacity: 0.85;
}

.share-btn.btn-disabled {
  background: #D2D2D8;
  color: #86868F;
}

/* ============ 页脚 ============ */
.footer {
  text-align: center;
  padding: 32rpx 24rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #86868F;
}
