<!-- pages/share-card/share-card.wxml -->
<view class="container">
  <!-- Canvas 预览 -->
  <view class="canvas-wrap">
    <share-card-canvas
      id="card"
      budget="{{budget}}"
      category="{{category}}"
      category-label="{{categoryLabel}}"
      top-plan="{{topPlan}}"
      frontier="{{frontier}}"
      last-updated="{{lastUpdated}}"
      qrcode-base64="{{qrcodeBase64}}"
      app-name="{{appName}}"
    />
  </view>

  <!-- 降级提示(canvas 渲染失败时) -->
  <view class="fallback-tip" wx:if="{{renderFailed}}">
    <view class="fallback-text">分享卡渲染失败，请截取上方画面分享</view>
  </view>

  <!-- 「展示我的方案」复选框: 勾选 → 图片上加小程序码 (调云函数); 不勾选 → 只显小程序名 -->
  <view class="option-row">
    <view class="option-label">
      <view class="option-title">展示我的方案</view>
      <view class="option-desc">将把您的方案上传到云端并通过二维码查看。无论是否上传，均可点击生成的分享卡打开本次结果。您分享的数据对于保持数据更新至关重要！。</view>
    </view>
    <switch checked="{{showMyPlan}}" bindchange="onToggleShowMyPlan" color="#007AFF" />
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <view class="action-btn primary" bindtap="onGenerate">
      {{generated ? '重新生成' : '生成分享卡'}}
    </view>
    <view class="action-btn secondary" wx:if="{{generated}}" bindtap="onSaveToAlbum">
      保存到相册
    </view>
    <button class="action-btn secondary share-btn" open-type="share" wx:if="{{generated}}">
      转发给朋友
    </button>
  </view>

  <!-- 分享呼吁 -->
  <view class="share-call">
    帕累托买苹果是一个个人维护的开源项目，越多人使用并分享自己的成交价，我们的预测越准，请分享给更多人。
  </view>

  <!-- 预览图 -->
  <view class="preview-wrap" wx:if="{{tempFilePath}}">
    <view class="preview-label">分享卡预览</view>
    <image class="preview-img" src="{{tempFilePath}}" mode="aspectFit" />
  </view>

  <!-- 项目仓库链接 -->
  <repo-footer />
</view>
