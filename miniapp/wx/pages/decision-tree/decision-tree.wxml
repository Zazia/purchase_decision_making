<!-- pages/decision-tree/decision-tree.wxml -->
<wxs module="util">
  // 数组包含判断 (WXML 模板内无法直接调用 Array.includes)
  function includes(arr, val) {
    if (!arr) return false;
    for (var i = 0; i < arr.length; i++) {
      if (arr[i] === val) return true;
    }
    return false;
  }
  module.exports = { includes: includes };
</wxs>

<view class="container">
  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progress}}%;"></view>
    </view>
    <text class="progress-text">第 {{currentStep + 1}} / {{steps.length}} 步</text>
  </view>

  <!-- 步骤内容 -->
  <view class="step-container {{fadeClass}}" wx:for="{{steps}}" wx:key="key" wx:if="{{index === currentStep}}">
    <view class="step-title">{{item.title}}</view>

    <!-- 单选步骤: 卡片列表 -->
    <block wx:if="{{!item.multi}}">
      <view class="options">
        <view
          class="option-card"
          wx:for="{{item.options}}"
          wx:for-item="opt"
          wx:key="label"
          data-step="{{item.key}}"
          data-value="{{opt.value}}"
          bindtap="onSelectOption"
        >
          <view class="option-label">{{opt.label}}</view>
          <view class="option-desc" wx:if="{{opt.desc}}">{{opt.desc}}</view>
        </view>
      </view>
    </block>

    <!-- 多选步骤: chip 网格 + 都看看快捷项 + 下一步 -->
    <block wx:else>
      <view class="chips">
        <view
          class="chip {{util.includes(multiSelected, opt.value) ? 'chip-selected' : ''}}"
          wx:for="{{item.options}}"
          wx:for-item="opt"
          wx:key="label"
          data-step="{{item.key}}"
          data-value="{{opt.value}}"
          bindtap="onToggleMulti"
        >
          <text class="chip-label">{{opt.label}}</text>
        </view>
      </view>

      <!-- 都看看快捷项 -->
      <view
        class="quick-all-card"
        data-step="{{item.key}}"
        bindtap="onQuickAll"
      >
        <text class="quick-all-text">{{item.quickAll}}</text>
      </view>

      <!-- 下一步按钮 (至少选 1 个才能点) -->
      <view class="multi-next-wrap">
        <view class="multi-next-btn {{canProceedMulti ? '' : 'disabled'}}" bindtap="onMultiNext">下一步</view>
      </view>
    </block>

    <!-- 不确定/帮我选 -->
    <view class="unsure-card" bindtap="onSelectUnsure">
      <text class="unsure-text">不确定 / 帮我选</text>
    </view>
  </view>

  <!-- 上一步按钮 -->
  <view class="nav-bar">
    <view class="nav-btn back" wx:if="{{currentStep > 0}}" bindtap="prevStep">上一步</view>
  </view>

  <!-- AI 顾问提示 -->
  <view class="ai-hint {{showAiHint ? 'show' : ''}}">
    AI 顾问功能开发中, 已为您使用默认参数
  </view>
</view>
